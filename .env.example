# ==========================================
# SAVEit — Local Environment Configuration
# ==========================================

# Backend Server Configuration
PORT=5001
NODE_ENV=development

# Frontend Client URL (for CORS allowance)
CLIENT_URL=http://localhost:5173

# MongoDB Connection URI (matches docker-compose.yml service)
MONGO_URI=mongodb://localhost:27017/saveit

# AI Structuring & Intelligence (Phase 3)
# Get a free Gemini API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Future / Alternative Providers (Groq, Ollama, etc.)
# GROQ_API_KEY=
# REDIS_URL=redis://localhost:6379
