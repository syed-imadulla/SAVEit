{
  "name": "saveit",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered personal knowledge library for Instagram Reels and YouTube Shorts",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"blue,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:up": "docker compose up -d mongodb",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f mongodb",
    "graphify": "graphify extract . --code-only && graphify cluster-only ."
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "overrides": {
    "braces": "^3.0.3",
    "postcss-selector-parser": "^7.1.6"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
